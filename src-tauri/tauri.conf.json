{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Luma Studio",
  "version": "0.1.0",
  "identifier": "app.luma.studio",
  "build": {
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Luma Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 1160,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
