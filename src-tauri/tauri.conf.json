{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Luma Studio",
  "version": "0.1.0",
  "identifier": "app.luma.studio",
  "build": {
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run desktop:build",
    "frontendDist": "../dist-desktop"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Luma Studio",
        "url": "index.html?build=layer-focus-v23",
        "width": 1440,
        "height": 900,
        "minWidth": 1160,
        "minHeight": 700,
        "resizable": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 16, "y": 18 },
        "acceptFirstMouse": true,
        "theme": "Light"
      }
    ],
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost http://localhost:3000 ws://localhost:3000 https://luma-studio-preview.armonon.chatgpt.site; img-src 'self' asset: http://asset.localhost blob: data:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
