{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Luma Studio",
  "version": "0.6.0-rc.0",
  "identifier": "app.luma.studio",
  "build": {
    "beforeBuildCommand": "npm run desktop:build",
    "frontendDist": "../dist-desktop"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Luma Studio",
        "url": "index.html?build=graphite-workspace-v25",
        "width": 1440,
        "height": 900,
        "minWidth": 1160,
        "minHeight": 700,
        "resizable": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 18
        },
        "acceptFirstMouse": true,
        "theme": "Dark",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost https://huggingface.co https://*.huggingface.co https://us.aws.cdn.hf.co https://luma-studio-preview.armonon.chatgpt.site; img-src 'self' asset: http://asset.localhost blob: data:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "hardenedRuntime": true,
      "signingIdentity": "-"
    },
    "fileAssociations": [
      {
        "ext": [
          "luma"
        ],
        "name": "Luma Document",
        "description": "Luma Studio document",
        "role": "Editor"
      },
      {
        "ext": [
          "psd",
          "psb"
        ],
        "name": "Photoshop Document",
        "description": "Adobe Photoshop document",
        "role": "Editor"
      },
      {
        "ext": [
          "png",
          "jpg",
          "jpeg",
          "webp",
          "tif",
          "tiff"
        ],
        "name": "Image",
        "description": "Raster image",
        "role": "Viewer"
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": []
    }
  }
}
