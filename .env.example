# Configure this as a hosted Sites secret. Never expose it to browser code.
# Generative editing (/api/ai/edit) returns 503 until this is set.
OPENAI_API_KEY=

# Optional. Defaults to "gpt-image-2" — override if you deploy against a
# different image editing model.
AI_IMAGE_MODEL=

# Server-only HTTPS destination for sanitized crash payloads. This can be a
# collector webhook or a private ingestion service. The optional token is sent
# only from Luma's server-side proxy and never bundled into either edition.
LUMA_CRASH_WEBHOOK_URL=
LUMA_CRASH_WEBHOOK_TOKEN=

# Public URL of this deployment's crash proxy, for example
# https://luma.example/api/diagnostics/crash. Desktop/web clients reject HTTP.
NEXT_PUBLIC_LUMA_CRASH_ENDPOINT=
NEXT_PUBLIC_LUMA_RELEASE=
