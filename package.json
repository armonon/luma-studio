{
  "name": "luma-studio",
  "version": "0.6.0-rc.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "pdf:vendor": "node build/vendor-pdf-resources.mjs",
    "print:inspect": "tsx build/inspect-print-delivery.ts",
    "benchmark:compare": "tsx build/compare-affinity-evidence.ts",
    "benchmark:matched": "tsx build/compare-matched-evidence.ts",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:netlify": "next build",
    "bundle:check": "npm run build && node build/report-client-bundle.mjs --check",
    "corpus:check": "tsx build/run-compatibility-corpus.ts --manifest compatibility-corpus/manifest.json --minimum 50",
    "corpus:external": "tsx build/qualify-photoshop-external.ts",
    "qualify:local": "node build/qualify-local.mjs",
    "rc0:check": "npm run qualify:local && npm run desktop:build && node build/check-release-evidence.mjs rc0",
    "rc1:check": "npm run rc0:check && npm run corpus:check && node build/check-release-evidence.mjs rc1",
    "rc2:check": "npm run rc1:check && node build/check-release-evidence.mjs rc2",
    "release:status": "node build/check-release-evidence.mjs status",
    "release:configure": "node build/generate-tauri-release-config.mjs",
    "release:verify-macos": "node build/verify-macos-release.mjs",
    "bundle:audit": "node build/audit-desktop-bundle.mjs",
    "crash:verify": "node build/verify-crash-endpoint.mjs",
    "desktop:build": "node build/vendor-onnx-runtime.mjs && vite build --config vite.desktop.config.ts",
    "desktop:dev": "node build/vendor-onnx-runtime.mjs && vite --config vite.desktop.config.ts --port 3000 --strictPort",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs && tsx --test tests/*.test.ts",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "pro:dev": "NEXT_PUBLIC_LUMA_EDITION=pro tauri dev --config src-tauri/tauri.dev.conf.json",
    "pro:build": "node build/run-tauri-build.mjs",
    "pro:release": "npm run release:configure && node build/run-tauri-build.mjs --config src-tauri/tauri.release.conf.json",
    "pro:notarize": "node build/notarize-desktop-bundle.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@xmldom/xmldom": "0.9.12",
    "ag-psd": "^31.0.2",
    "bidi-js": "1.1.0",
    "clipper-lib": "6.4.2",
    "drizzle-orm": "0.45.2",
    "harfbuzzjs": "1.6.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "next": "16.3.6",
    "opentype.js": "2.0.0",
    "paper": "0.12.18",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.3.289",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.58.0",
    "@cloudflare/workers-types": "5.20260923.1",
    "@napi-rs/canvas": "^1.0.3",
    "@netlify/plugin-nextjs": "^5.15.13",
    "@tailwindcss/postcss": "4.2.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "22.19.19",
    "@types/opentype.js": "1.3.10",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.185.1",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.6",
    "fake-indexeddb": "6.2.5",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "tsx": "4.22.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.2.0",
    "wrangler": "4.137.0"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "image-size": "2.0.4",
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  },
  "type": "module"
}
